    "event_slot_images": { ".read": true },
    "events": { ".read": true },
    "fashions": { ".read": true },
    "foods": { ".read": true },
    "gacha_banner": { ".read": true },
    "gacha_categories": { ".read": true },
    "gacha_items": { ".read": true },
    "gkey": { ".read": true },
    "items": { ".read": true },
    "jobs": { ".read": true },
    "runes": { ".read": true },
